{
    "train_csv_path": "../data_LLM/metadata_train.csv",
    "validation_csv_path": "../data_LLM/metadata_val.csv",
    "test_csv_path": "../data_LLM/metadata_test.csv",
    "model_name": "facebook/dinov2-small",
    "class_names": [
        "healthy",
        "infected"
    ],
    "label2id": {
        "healthy": 0,
        "infected": 1
    },
    "id2label": {
        "0": "healthy",
        "1": "infected"
    },
    "seed": 7,
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "effective_batch_size": 8,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "num_epochs": 20,
    "early_stopping_patience": 4,
    "warmup_ratio": 0.1,
    "num_workers": 2
}